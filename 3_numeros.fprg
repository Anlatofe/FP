<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="3 numeros"/>
        <attribute name="authors" value="ANLATOFE"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-24 08:14:28 p.&#8239;m."/>
        <attribute name="created" value="QU5MQVRPRkU7QUlST0tBOzIwMjYtMDQtMjQ7MDc6NTA6MDYgcC7igK9tLjsxMDcwMg=="/>
        <attribute name="edited" value="QU5MQVRPRkU7QUlST0tBOzIwMjYtMDQtMjQ7MDg6MTQ6MjggcC7igK9tLjszOzEwODE3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Numero1, Numero2, Numero3, Mayor" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite el primer digito&quot;" newline="True"/>
            <input variable="Numero1"/>
            <output expression="&quot;Digite el segundo digito&quot;" newline="True"/>
            <input variable="Numero2"/>
            <output expression="&quot;Ahora digite el tercer digito&quot;" newline="True"/>
            <input variable="Numero3"/>
            <if expression="Numero1 &gt; Numero2">
                <then>
                    <assign variable="Mayor" expression="Numero1"/>
                </then>
                <else>
                    <assign variable="Mayor" expression="Numero2"/>
                </else>
            </if>
            <if expression="Mayor &gt; Numero3">
                <then>
                    <output expression="&quot;El n&#250;mero &quot; &amp; Mayor &amp; &quot; es el mayor&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;El n&#250;mero &quot; &amp; Numero3 &amp; &quot; es el mayor&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
